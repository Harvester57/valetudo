{
	"name": "valetudo-re",
	"version": "0.10.11",
	"versionSuffix": "",
	"description": "Self-contained control webinterface for xiaomi vacuum robots",
	"main": "index.js",
	"bin": "index.js",
	"license": "Apache-2.0",
	"pkg": {
		"assets": [
			"client/**/*"
		]
	},
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"prebuild": "cp -a client client.b && find client/ -type f \\( -iname \\*.json -o -iname \\*.js -o -iname \\*.html -o -iname \\*.css \\) -exec gzip -9 {} +",
		"build-debug": "pkg --targets node16-linuxstatic-armv7 --compress -d --options jitless,no-use-idle-notification,max-old-space-size=32,optimize_for_size,gc_interval=100 --public-packages=prettycron . --output valetudo",
		"build": "pkg --targets node16-linuxstatic-armv7 --compress --no-bytecode --options jitless,no-use-idle-notification,max-old-space-size=32,optimize_for_size,gc_interval=100 --public-packages=prettycron . --output valetudo",
		"postbuild": "if [ -d client.b ]; then rm -fr client && mv client.b client; fi",
		"prettier": "./node_modules/.bin/prettier --check ./src/",
		"lint": "./node_modules/.bin/eslint --max-warnings=0 --ext=js ."
	},
	"author": "",
	"dependencies": {
		"body-parser": "^1.20.3",
		"compression": "^1.8.1",
		"express": "^4.21.2",
		"express-basic-auth": "^1.2.1",
		"express-dynamic-middleware": "^1.0.0",
		"express-force-ssl": "^0.3.2",
		"mqtt": "^4.3.8",
		"multer": "^2.0.2",
		"pngjs": "^7.0.0",
		"prettier": "^3.6.2",
		"prettycron": "^0.10.0",
		"slimbot": "^5.1.0",
		"socks5-client": "^1.2.8",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"eslint": "^9.39.1",
		"eslint-plugin-react": "^7.37.5",
		"globals": "^16.5.0",
		"pkg": "5.8.1"
	}
}
